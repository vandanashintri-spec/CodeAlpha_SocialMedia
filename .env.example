# Local development defaults. Keep real credentials in .env or your host settings.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

# Leave empty to use the existing local SQLite database.
DATABASE_URL=

# Production media accepts JPEG, PNG, and WebP files up to 5 MB and uses
# S3-compatible storage (for example AWS S3 or Cloudflare R2).
# Leave these blank in local development to use the project's media/ directory.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set the API endpoint for compatible providers such as R2; optional for AWS S3.
AWS_S3_ENDPOINT_URL=
# Public media hostname only (no https:// prefix); provider/CDN dependent.
AWS_S3_CUSTOM_DOMAIN=

# Email verification and password reset.
# Local development always uses Django's console email backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Connect <noreply@example.com>
